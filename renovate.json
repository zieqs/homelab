{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)apps/.+/deployment\\.yaml$/",
      "/(^|/)infrastructure/.+/deployment\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/(^|/)apps/.+/release\\.yaml$/",
      "/(^|/)infrastructure/.+/release\\.yaml$/"
    ]
  },
  "ignorePaths": [
    "clusters/homelab/flux-system/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track itzg/minecraft-server:java21 image tag and digest",
      "managerFilePatterns": [
        "/(^|/)apps/minecraft/deployment\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>itzg/minecraft-server):(?<currentValue>java21)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "registryAliases": {
        "johanneskastl": "https://johanneskastl.github.io/helm-charts",
        "pihole": "https://mojo2600.github.io/pihole-kubernetes",
        "tailscale": "https://pkgs.tailscale.com/helm"
      }
    },
    {
      "matchCategories": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "labels": ["docker-major"],
      "automerge": false
    }
  ]
}