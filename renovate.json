{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "kubernetes": {
    "enabled": true
  },
  "flux": {
    "enabled": true
  },
  "docker": {
    "pinDigests": true
  },
  "ignorePaths": [
    "clusters/homelab/flux-system/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track itzg/minecraft-server:java21 digest and VERSION env",
      "managerFilePatterns": ["apps/minecraft/deployment.yaml"],
      "matchStrings": ["image: itzg/minecraft-server:(?<currentValue>java21)", "VERSION: \"(?<currentValue>.*)\""],
      "datasourceTemplate": "docker",
      "depNameTemplate": "itzg/minecraft-server",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "labels": ["docker-major"],
      "automerge": false
    }
  ]
}
