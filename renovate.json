{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "kubernetes": {
    "fileMatch": [
      "(^|/)apps/.+/deployment\\.yaml$",
      "(^|/)infrastructure/.+/deployment\\.yaml$"
    ]
  },
  "flux": {
    "fileMatch": [
      "(^|/)apps/.+/release\\.yaml$",
      "(^|/)infrastructure/.+/release\\.yaml$"
    ]
  },
  "ignorePaths": [
    "clusters/homelab/flux-system/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track itzg/minecraft-server:java21 image tag",
      "fileMatch": ["(^|/)apps/minecraft/deployment\\.yaml$"],
      "matchStrings": [
        "image:\\s*(?<depName>itzg/minecraft-server):(?<currentValue>[^\\s\"]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchCategories": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "labels": ["docker-major"],
      "automerge": false
    }
  ]
}